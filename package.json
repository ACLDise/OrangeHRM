{
  "name": "automatizacion-orangehrm-bdd",
  "version": "1.0.0",
  "private": true,
  "description": "Suite de automatización de pruebas para OrangeHRM con Playwright, TypeScript, BDD, Gherkin y Page Object Model",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "playwright test",
    "test:chromium": "playwright test --project=chromium",
    "bdd:generate": "bddgen",
    "test:bdd": "bddgen && playwright test --project=bdd",
    "report": "playwright show-report",
    "plantilla": "ts-node scripts/create-template.ts",
    "prepare-data": "ts-node scripts/prepare-data.ts",
    "listar": "ts-node scripts/list-cases.ts",
    "dryrun": "cucumber-js --profile dryrun",
    "test:admin": "cucumber-js --profile default",
    "test:admin:headed": "cucumber-js --profile headed",
    "report:admin": "ts-node scripts/report.ts",
    "abrir": "ts-node scripts/open-last.ts",
    "typecheck": "tsc --noEmit"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ACLDise/OrangeHRM.git"
  },
  "devDependencies": {
    "@cucumber/cucumber": "^13.3.0",
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.5",
    "dotenv": "^18.0.8",
    "exceljs": "^4.4.0",
    "playwright": "^1.64.1",
    "playwright-bdd": "^9.2.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  }
}
